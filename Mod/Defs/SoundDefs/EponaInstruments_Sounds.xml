<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Same shape as the provider's MIC_*_Play sounds (Musical Instruments (Continued)): sustained, positional, map only. -->
  <SoundDef>
    <defName>EponaIR_GreatHighlandBagpipes_Play</defName>
    <context>MapOnly</context>
    <sustain>True</sustain>
    <sustainFadeoutTime>0.25</sustainFadeoutTime>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipPath>EponaInstruments/Bagpipes/</clipPath>
          </li>
        </grains>
        <volumeRange>75</volumeRange>
        <distRange>5~25</distRange>
        <muteWhenPaused>True</muteWhenPaused>
      </li>
    </subSounds>
  </SoundDef>

